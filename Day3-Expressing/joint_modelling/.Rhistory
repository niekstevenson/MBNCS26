library(EMC2)
set.seed(123456)
possible_paths <- c(
"_data/Kvam2019.csv"
)
data_path <- possible_paths[file.exists(possible_paths)][1]
if (is.na(data_path)) {
stop(
"Could not find the Kvam2019 data file. Place it in '_data/Kvam2019.csv' ",
"or in the same directory as this R Markdown file."
)
}
data <- read.csv(
data_path,
header = TRUE,
stringsAsFactors = FALSE
)
# Convert experimental variables to factors
data$subjects <- factor(data$subjects)
data$isSpeed <- factor(
data$isSpeed,
levels = c(0, 1),
labels = c("accuracy", "speed")
)
data$jitter <- factor(data$jitter)
head(data)
cat("Number of participants:", nlevels(data$subjects), "\n")
cat("Number of trials:", nrow(data), "\n\n")
with(data, table(jitter, isSpeed))
single_subject <- levels(data$subjects)[3]
data_single <- droplevels(
data[data$subjects == single_subject, , drop = FALSE]
)
cat("Participant:", single_subject, "\n")
cat("Number of trials:", nrow(data_single), "\n")
acc_fun <- function(data) {
data$abs_error <= pi
}
plot_density(
data_single,
factors = "jitter",
functions = c(correct = acc_fun),
defective_factor = "correct"
)
?CDM
design_CDM_SAT <- design(
data = data_single,
Rlevels = "R",
formula = list(
v     ~ 0 + jitter,
theta ~ 1,
a     ~ isSpeed,
t0    ~ 1
),
model = CDM
)
.rs.restartR()
knitr::opts_chunk$set(
echo = TRUE,
message = FALSE,
warning = FALSE,
fig.align = "center",
fig.width = 8,
fig.height = 5
)
print(design_CDM_SAT)
summary(design_CDM_SAT)
sampled_pars(design_CDM_SAT)
p_vector <- c(
v_jitter15       = log(2),
v_jitter30       = log(1.5),
v_jitter45       = log(1),
theta            = qnorm(0.5),
a                = log(1),
a_isSpeedspeed   = -0.2,
t0               = log(0.3)
)
prior_sd <- c(
v_jitter15       = 1,
v_jitter30       = 1,
v_jitter45       = 1,
theta            = 0.3,
a                = 2,
a_isSpeedspeed   = 0.2,
t0               = 0.4
)
prior_CDM_SAT <- prior(
design_CDM_SAT,
pmean = p_vector,
psd = prior_sd,
type = "single"
)
prior_CDM_SAT
emc <- make_emc(
data = data_single,
design = design_CDM_SAT,
prior = prior_CDM_SAT,
type = "single"
)
CDM_emc <- fit(emc)
